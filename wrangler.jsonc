{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mawid-reminders",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-14",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "mawid", "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID" }],
  "triggers": { "crons": ["*/5 * * * *"] }
}
