# Configure real values only through ignored .dev.vars / provider secrets.
AUTH_PEPPER=REPLACE_WITH_A_RANDOM_32_BYTE_HEX_KEY
VAPID_SUBJECT=mailto:YOUR_ADMIN_EMAIL
VAPID_PUBLIC_KEY=YOUR_PUBLIC_PUSH_KEY
VAPID_PRIVATE_KEY=YOUR_PRIVATE_PUSH_KEY
# Optional: close public registrations while keeping existing sign-in working.
REGISTRATION_OPEN=true
