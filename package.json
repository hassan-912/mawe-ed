{
  "name": "mawid-reminders",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "db:local": "wrangler d1 migrations apply mawid --local",
