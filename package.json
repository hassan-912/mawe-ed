    "brand": "node scripts/render-brand.mjs",
    "verify:local": "node scripts/verify-worker.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
